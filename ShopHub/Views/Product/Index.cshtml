@model List<ShopHub.Models.Product>
@{
    ViewData["Title"] = "Каталог";
    var categories = ViewBag.Categories as List<ShopHub.Models.Category> ?? new();
}

<h2 class="mb-4">Каталог товаров</h2>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Все</a>
    @foreach (var cat in categories)
    {
        <a asp-action="Index" asp-route-categoryId="@cat.Id"
           class="btn btn-outline-secondary btn-sm">@cat.Name</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Товаров пока нет.</div>
}
else
{
    <div class="row g-4">
        @foreach (var p in Model)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="text-muted small mb-2">@p.Category?.Name</p>
                        <p class="card-text small flex-grow-1">
                            @(p.Description?.Length > 80
                                                ? p.Description.Substring(0, 80) + "..."
                                                : p.Description)
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="h5 mb-0">@p.Price.ToString("N0") ₽</span>
                    <span class="badge bg-@(p.Stock > 0 ? "success" : "secondary")">
                        @(p.Stock > 0 ? $"в наличии: {p.Stock}" : "нет")
                    </span>
                </div>
                <a asp-action="Details" asp-route-id="@p.Id"
                   class="btn btn-primary btn-sm mt-3">Подробнее</a>
            </div>
        </div>
    </div>
        }
    </div>
}