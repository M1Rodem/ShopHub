@model ShopHub.Models.User
@{
    ViewData["Title"] = "Профиль";
}

<h2 class="mb-4">Мой профиль</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Account" asp-action="Profile" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Имя</label>
                    <input name="firstName" class="form-control" value="@Model.FirstName" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Фамилия</label>
                    <input name="lastName" class="form-control" value="@Model.LastName" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Телефон</label>
                <input name="phone" class="form-control" value="@Model.Phone" />
            </div>

            <div class="mb-3">
                <label class="form-label">Адрес доставки</label>
                <textarea name="address" class="form-control" rows="2">@Model.Address</textarea>
            </div>

            <button type="submit" class="btn btn-primary">Сохранить</button>
        </form>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Информация</h5>
                <p><strong>Роль:</strong> @Model.Role</p>
                <p><strong>Зарегистрирован:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                @if (Model.LastLogin.HasValue)
                {
                    <p><strong>Последний вход:</strong> @Model.LastLogin.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                }
                <a asp-controller="Order" asp-action="Index" class="btn btn-outline-primary mt-2">
                    Мои заказы
                </a>
            </div>
        </div>
    </div>
</div>