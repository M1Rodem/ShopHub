@model ShopHub.Models.Report
@{
    ViewData["Title"] = "Отчёты";
}

<h2 class="mb-4">📊 Отчёт по продажам</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label">С</label>
        <input type="date" name="from" class="form-control"
               value="@Model.From.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label class="form-label">По</label>
        <input type="date" name="to" class="form-control"
               value="@Model.To.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Показать</button>
    </div>
</form>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="text-muted">Выручка</h6>
                <p class="display-6">@Model.TotalRevenue.ToString("N0") ₽</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="text-muted">Заказов</h6>
                <p class="display-6">@Model.OrdersCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="text-muted">Продано товаров</h6>
                <p class="display-6">@Model.ProductsSold</p>
            </div>
        </div>
    </div>
</div>

<h4>🏆 Топ-10 товаров</h4>

@if (!Model.TopProducts.Any())
{
    <p class="text-muted">За выбранный период продаж не было.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Товар</th>
                <th class="text-end">Продано, шт.</th>
                <th class="text-end">Выручка</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
            }
            @foreach (var row in Model.TopProducts)
            {
                <tr>
                    <td>@i</td>
                    <td>@row.ProductName</td>
                    <td class="text-end">@row.QuantitySold</td>
                    <td class="text-end">@row.Revenue.ToString("N0") ₽</td>
                </tr>
                i++;
            }
        </tbody>
    </table>
}