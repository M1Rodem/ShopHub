@model ShopHub.Models.Cart
@{
    ViewData["Title"] = "Корзина";
    decimal total = 0;
}

<h2 class="mb-4">🛒 Корзина</h2>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Корзина пуста.
        <a asp-controller="Product" asp-action="Index">Перейти в каталог</a>
    </div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Цена</th>
                <th>Кол-во</th>
                <th class="text-end">Сумма</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var subtotal = item.Price * item.Quantity;
                total += subtotal;
                <tr>
                    <td>
                        <a asp-controller="Product" asp-action="Details"
                           asp-route-id="@item.ProductId">@item.Product?.Name</a>
                    </td>
                    <td>@item.Price.ToString("N0") ₽</td>
                    <td>@item.Quantity</td>
                    <td class="text-end">@subtotal.ToString("N0") ₽</td>
                    <td>
                        <form asp-action="Remove" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button class="btn btn-sm btn-outline-danger">✕</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Итого:</th>
                <th class="text-end">@total.ToString("N0") ₽</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <div class="text-end">
        <a asp-controller="Order" asp-action="Checkout"
           class="btn btn-primary btn-lg">Оформить заказ</a>
    </div>
}