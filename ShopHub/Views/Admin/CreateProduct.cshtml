@{
    ViewData["Title"] = "Новый товар";
    var categories = ViewBag.Categories as List<ShopHub.Models.Category> ?? new();
}

<h2 class="mb-4">➕ Новый товар</h2>

<form asp-action="CreateProduct" method="post">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                <label class="form-label">Название</label>
                <input name="Name" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea name="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Цена, ₽</label>
                    <input name="Price" type="number" step="0.01" min="0"
                           class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Остаток</label>
                    <input name="Stock" type="number" min="0" value="0"
                           class="form-control" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Категория</label>
                <select name="CategoryId" class="form-select" required>
                    <option value="">— выберите —</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                @if (!categories.Any())
                {
                    <div class="form-text text-danger">
                        Нет ни одной категории. Создайте её в БД вручную.
                    </div>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6>Подсказка</h6>
                    <p class="small text-muted">
                        Товар сразу станет активным и появится в каталоге.
                        <code>IsActive = true</code>.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>
    <a asp-action="Products" class="btn btn-link">Отмена</a>
</form>