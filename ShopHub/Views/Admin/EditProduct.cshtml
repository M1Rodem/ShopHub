@model ShopHub.Models.Product
@{
    ViewData["Title"] = $"Редактирование: {Model.Name}";
    var categories = ViewBag.Categories as List<ShopHub.Models.Category> ?? new();
}

<h2 class="mb-4">✏️ Редактирование товара</h2>

<form asp-action="EditProduct" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="Id" value="@Model.Id" />
    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("o")" />
    <input type="hidden" name="SellerId" value="@Model.SellerId" />

    <div class="row">
        <div class="col-md-8">
            <div class="mb-3">
                <label class="form-label">Название</label>
                <input name="Name" class="form-control" value="@Model.Name" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Описание</label>
                <textarea name="Description" class="form-control" rows="4">@Model.Description</textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Цена, ₽</label>
                    <input name="Price" type="number" step="0.01" min="0"
                           class="form-control" value="@Model.Price" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Остаток</label>
                    <input name="Stock" type="number" min="0"
                           class="form-control" value="@Model.Stock" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Активен</label>
                    <select name="IsActive" class="form-select">
                        <option value="true" selected="@Model.IsActive">Да</option>
                        <option value="false" selected="@(!Model.IsActive)">Нет</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Категория</label>
                <select name="CategoryId" class="form-select" required>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CategoryId)">
                            @c.Name
                        </option>
                    }
                </select>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Products" class="btn btn-link">Отмена</a>
</form>